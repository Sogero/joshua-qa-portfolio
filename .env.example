# Resend (https://resend.com) — powers the contact form
RESEND_API_KEY=
# Where messages are delivered (defaults to the email in src/data/content.ts)
CONTACT_TO_EMAIL=
# Sender. Leave blank to use Resend's test sender (onboarding@resend.dev),
# or set to an address on a domain you've verified in Resend, e.g. "Portfolio <contact@yourdomain.com>"
CONTACT_FROM_EMAIL=
# Optional: final site URL for SEO metadata
NEXT_PUBLIC_SITE_URL=

# Cloudflare Turnstile (free CAPTCHA) — https://dash.cloudflare.com → Turnstile → Add site
# Leave blank to run without it; set BOTH to enable it on the contact form.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
